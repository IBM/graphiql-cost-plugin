{
  "name": "graphiql-cost-plugin",
  "version": "1.0.3",
  "description": "Plugin for the GraphiQL IDE that displays GraphQL query cost information",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "validate": "node -e \"require('./dist/index.js')\" && node --input-type=module -e \"import('./dist/index.mjs')\""
  },
  "engines": {
    "node": "^18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:IBM/graphiql-cost-plugin.git"
  },
  "contributors": [
    "Erik Wittern, Ketki Thakre"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/react": "^18.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "react": "^16.14.0 || ^17.0.0 || ^18.0.0"
  },
  "overrides": {
    "esbuild": "^0.25.0"
  }
}
